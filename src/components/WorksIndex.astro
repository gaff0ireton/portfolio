---
import Sectionhead from './Sectionhead.astro';
import { sections } from '../data/sections';

import { works } from '../data/works';
const clientWorks = works.filter(({ type }) => type === 'client works');
const personalWorks = works.filter(({ type }) => type === 'personal works');

import WorksModal from './WorksModal.astro';
import WorksIndexList from './WorksIndexList';
import WorksIndexTitle from './WorksIndexTitle';
---

<section id={sections.works.id} class="works">
  <Sectionhead section={sections.works} />

  <div class="worksIndex">
    <section class="worksIndex__client">
      <WorksIndexTitle title="client works" subTitle="実案件" client:load />
      <WorksIndexList works={clientWorks} client:load />
    </section>
    <section class="worksIndex__persona">
      <WorksIndexTitle title="personal works" subTitle="自主制作" client:load />
      <WorksIndexList works={personalWorks} client:load />
    </section>
  </div>
</section>

