---
import Sectionhead from './Sectionhead.astro';
import { sections } from '../data/sections';
const skill = [
  { title: 'FRONT-END', subtitle: 'フロントエンド', detail: 'HTML / CSS / Scss / JavaScript / Astro / React' },
  { title: 'BACK-END', subtitle: 'バックエンド', detail: 'PHP / CodeIgniter' },
  {
    title: 'DESIGN TOOLS',
    subtitle: 'デザインソフト',
    detail: 'Figma / Adobe XD / Affinity / Photoshop / illustrator',
  },
  {
    title: 'DEVELOPMENT TOOLS',
    subtitle: '開発者ツール',
    detail: 'Git / GitHub / VS Code / npm / pnpm / Gulp / Xampp',
  },
  {
    title: 'DATABASE',
    subtitle: 'データベース',
    detail: 'MySQL / MariaDB\nBasic SQL Operations',
  },
  {
    title: 'CMS',
    detail: 'SiteCore\nPage Registration / Update / Publishing',
  },
];
---

<section id={sections.skills.id} class="skills">
  <Sectionhead section={sections.skills} />
  <dl class="skills__list">
    {skill.map((item) => {
      return (
        <div class="skills__box">
          <dt class="skills__heading">
            <span class="glitch-text-02 skills__icon" aria-hidden="true">
              〼
            </span>
            <span class="glitch-text-02 skills__title">{item.title}</span>
            <span class="skills__subtitle">{item.subtitle}</span>
          </dt>
          <dd class="skills__detail">{item.detail}</dd>
        </div>
      );
    })}
  </dl>
</section>
